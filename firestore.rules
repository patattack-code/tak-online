rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validProfile(d) {
      return d.displayName is string
        && d.displayName.size() >= 1 && d.displayName.size() <= 50
        && (d.photoURL == null
            || (d.photoURL is string && d.photoURL.size() <= 512 && d.photoURL.matches('^https://.*')));
    }

    // A statistics write on users/{uid} is legal only as part of the batch that
    // finishes a rated game between the writer and {uid}. getAfter() sees the
    // game as it will be once the batch commits; get() sees it as it was.
    // The rating change must equal the delta recorded on the game, which the
    // game rules bound and sign-check, so nobody can hand themselves points.
    function ratingUpdateOk(uid) {
      let gid = request.resource.data.lastRatedGame;
      let before = get(/databases/$(database)/documents/games/$(gid)).data;
      let after = getAfter(/databases/$(database)/documents/games/$(gid)).data;
      let key = 's' + string(after.size);
      let mine = request.resource.data.ratings[key];
      let old = resource.data.ratings.get(key, {'rating': 1500, 'games': 0});
      let delta = after.ratingDelta[uid];
      return gid is string
        && changedKeys().hasOnly(['ratings', 'totals', 'updatedAt', 'lastRatedGame'])
        && request.auth.uid in after.playerIds
        && uid in after.playerIds
        && before.status == 'active' && before.rated == true && before.ratingApplied == false
        && after.status == 'finished' && after.ratingApplied == true
        && request.resource.data.ratings.diff(resource.data.ratings).affectedKeys().hasOnly([key])
        && delta is int && delta >= -40 && delta <= 40
        && mine.rating == old.rating + delta
        && mine.games == old.games + 1
        && request.resource.data.totals.games == resource.data.totals.games + 1;
    }

    // Public player profiles with per-size ratings.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'createdAt', 'updatedAt', 'ratings', 'totals'])
        && validProfile(request.resource.data)
        && request.resource.data.ratings == {}
        && request.resource.data.totals == {'games': 0, 'wins': 0, 'losses': 0, 'draws': 0};
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && changedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
          && validProfile(request.resource.data))
        || ratingUpdateOk(uid)
      );
      allow delete: if false;
    }

    match /games/{gameId} {
      function me() { return request.auth.uid; }
      function d() { return request.resource.data; }
      function o() { return resource.data; }
      function opponentColor() { return o().white == me() ? 'black' : 'white'; }
      function opponentUid() { return o().white == me() ? o().black : o().white; }

      function validPlayerInfo(p) {
        return p.keys().hasOnly(['displayName', 'photoURL'])
          && p.displayName is string && p.displayName.size() >= 1 && p.displayName.size() <= 50
          && (p.photoURL == null
              || (p.photoURL is string && p.photoURL.size() <= 512 && p.photoURL.matches('^https://.*')));
      }

      function validResult(res, types) {
        return res.keys().hasOnly(['winner', 'type'])
          && res.type in types
          && ((res.type == 'draw' && res.winner == null)
              || (res.type != 'draw' && res.winner in ['white', 'black']));
      }

      function deltaOk(delta, won, lost) {
        return delta is int && delta >= -40 && delta <= 40
          && (!won || delta >= 0) && (!lost || delta <= 0);
      }

      // Rating bookkeeping on a finished game: untouched when unrated; when
      // rated, applied exactly once with bounded, correctly signed deltas.
      // The user rules then require each player's rating change to equal
      // the delta recorded here.
      function ratingFieldsOk() {
        let r = request.resource.data;
        let winner = r.result.winner;
        return (r.rated == false && r.ratingApplied == false && r.ratingDelta == {})
          || (r.rated == true && r.ratingApplied == true
              && r.ratingDelta.keys().hasOnly([r.white, r.black])
              && r.ratingDelta.keys().hasAll([r.white, r.black])
              && deltaOk(r.ratingDelta[r.white], winner == 'white', winner == 'black')
              && deltaOk(r.ratingDelta[r.black], winner == 'black', winner == 'white'));
      }

      function finishedShape() {
        let r = request.resource.data;
        return r.status == 'finished' && r.toMoveUid == null && ratingFieldsOk();
      }

      // The player to move appends exactly one well-formed PTN move. History
      // is append-only. The move either passes the turn or ends the game.
      function isMove() {
        let r = request.resource.data;
        let old = resource.data;
        let n = old.moves.size();
        return old.toMoveUid == request.auth.uid
          && changedKeys().hasOnly(['moves', 'toMoveUid', 'updatedAt', 'status', 'result', 'finishedAt', 'ratingApplied', 'ratingDelta'])
          && r.moves.size() == n + 1
          && (n == 0 || r.moves[0:n] == old.moves)
          && r.moves[n] is string
          && r.moves[n].matches('^[FSC]?[1-8]?[a-h][1-8]([-+<>][1-8]*)?$')
          && (
            (r.status == 'active' && r.result == null && r.toMoveUid == opponentUid()
              && r.ratingApplied == false && r.ratingDelta == {})
            || (finishedShape() && validResult(r.result, ['road', 'flat', 'draw']))
          );
      }

      // Either player may resign, which can only hand the win to the opponent.
      function isResign() {
        let r = request.resource.data;
        return changedKeys().hasOnly(['toMoveUid', 'updatedAt', 'status', 'result', 'finishedAt', 'ratingApplied', 'ratingDelta'])
          && finishedShape()
          && validResult(r.result, ['resign'])
          && r.result.winner == opponentColor();
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && gameId.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && gameId.size() <= 52
        && d().keys().hasOnly(['name', 'size', 'creator', 'creatorColor', 'white', 'black', 'playerIds', 'names',
                               'status', 'moves', 'toMoveUid', 'result', 'rated', 'ratingApplied', 'ratingDelta',
                               'createdAt', 'updatedAt', 'finishedAt'])
        && d().name is string && d().name.size() >= 1 && d().name.size() <= 60
        && d().size in [3, 4, 5, 6, 7, 8]
        && d().creator == me()
        && d().creatorColor in ['white', 'black', 'random']
        && d().white == null && d().black == null
        && d().playerIds == [me()]
        && d().names.keys().hasOnly([me()]) && validPlayerInfo(d().names[me()])
        && d().status == 'waiting' && d().moves == [] && d().toMoveUid == null && d().result == null
        && d().rated is bool && d().ratingApplied == false && d().ratingDelta == {};

      // Joining: a different signed-in user turns a waiting game active and
      // takes the colour the creator left open.
      allow update: if signedIn()
        && o().status == 'waiting'
        && me() != o().creator
        && changedKeys().hasOnly(['white', 'black', 'playerIds', 'names', 'status', 'toMoveUid', 'updatedAt'])
        && d().status == 'active'
        && d().playerIds == [o().creator, me()]
        && ((d().white == o().creator && d().black == me()) || (d().white == me() && d().black == o().creator))
        && (o().creatorColor == 'random' || ((o().creatorColor == 'white') == (d().white == o().creator)))
        && d().toMoveUid == d().white
        && d().names.keys().hasOnly([o().creator, me()])
        && d().names[o().creator] == o().names[o().creator]
        && validPlayerInfo(d().names[me()]);

      // Playing: participants only; a move by the player to move, or a resignation.
      allow update: if signedIn()
        && o().status == 'active'
        && me() in o().playerIds
        && (isMove() || isResign());

      // The creator may withdraw an unanswered challenge.
      allow delete: if signedIn()
        && o().status == 'waiting'
        && o().creator == me();
    }
  }
}
