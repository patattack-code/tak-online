rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validProfile(d) {
      return d.displayName is string
        && d.displayName.size() >= 1 && d.displayName.size() <= 50
        && (d.photoURL == null
            || (d.photoURL is string && d.photoURL.size() <= 512 && d.photoURL.matches('^https://.*')));
    }

    // A statistics write on users/{uid} is legal only as part of the batch that
    // finishes a rated game between the writer and {uid}. getAfter() sees the
    // game as it will be once the batch commits; get() sees it as it was.
    // The rating change must equal the delta recorded on the game, which the
    // game rules bound and sign-check, so nobody can hand themselves points.
    function ratingUpdateOk(uid) {
      let gid = request.resource.data.lastRatedGame;
      let before = get(/databases/$(database)/documents/games/$(gid)).data;
      let after = getAfter(/databases/$(database)/documents/games/$(gid)).data;
      let key = 's' + string(after.size);
      let mine = request.resource.data.ratings[key];
      let old = resource.data.ratings.get(key, {'rating': 1500, 'games': 0});
      let delta = after.ratingDelta[uid];
      return gid is string
        && changedKeys().hasOnly(['ratings', 'totals', 'updatedAt', 'lastRatedGame'])
        && request.auth.uid in after.playerIds
        && uid in after.playerIds
        && before.status == 'active' && before.rated == true && before.ratingApplied == false
        && after.status == 'finished' && after.ratingApplied == true
        && request.resource.data.ratings.diff(resource.data.ratings).affectedKeys().hasOnly([key])
        && delta is int && delta >= -40 && delta <= 40
        && mine.rating == old.rating + delta
        && mine.games == old.games + 1
        && request.resource.data.totals.games == resource.data.totals.games + 1;
    }

    // Public player profiles with per-size ratings.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'createdAt', 'updatedAt', 'ratings', 'totals'])
        && validProfile(request.resource.data)
        && request.resource.data.ratings == {}
        && request.resource.data.totals == {'games': 0, 'wins': 0, 'losses': 0, 'draws': 0};
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && changedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
          && validProfile(request.resource.data))
        || ratingUpdateOk(uid)
      );
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && gameId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && gameId.size() <= 52
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.creator == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.size in [3, 4, 5, 6, 7, 8]
        && request.resource.data.moves.size() == 0
        && request.resource.data.playerIds == [request.auth.uid];

      // Joining: a different signed-in user turns a waiting game active.
      allow update: if signedIn()
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'active'
        && request.auth.uid != resource.data.creator
        && request.resource.data.playerIds.hasAll([resource.data.creator, request.auth.uid])
        && request.resource.data.playerIds.size() == 2
        && request.resource.data.moves.size() == 0;

      // Playing: only participants, and only the player to move may add moves.
      // Resignation changes status without adding a move, so either player may do it.
      allow update: if signedIn()
        && resource.data.status == 'active'
        && request.auth.uid in resource.data.playerIds
        && request.resource.data.playerIds == resource.data.playerIds
        && request.resource.data.white == resource.data.white
        && request.resource.data.black == resource.data.black
        && request.resource.data.size == resource.data.size
        && request.resource.data.name == resource.data.name
        && request.resource.data.rated == resource.data.rated
        && (
          request.resource.data.moves == resource.data.moves
          || (resource.data.toMoveUid == request.auth.uid
              && request.resource.data.moves.size() == resource.data.moves.size() + 1)
        );

      // The creator may withdraw an unanswered challenge.
      allow delete: if signedIn()
        && resource.data.status == 'waiting'
        && resource.data.creator == request.auth.uid;
    }
  }
}
